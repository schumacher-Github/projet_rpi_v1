# Variables du déploiement conteneurisé RPI-PAD.
#
#   cp .env.docker.example .env.docker
#   # remplacer TOUTES les valeurs marquées « à remplacer »
#   docker compose --env-file .env.docker up -d
#
# Ce fichier d'exemple est versionné ; le fichier .env.docker qui en dérive
# contient des secrets et ne doit jamais être commité.

# ── Adresse publique de la plateforme sur le réseau du PAD ──────────────
PUBLIC_URL=https://rpi.pad.cm
VITE_SUPABASE_URL=https://rpi.pad.cm
SUPABASE_PROJECT_ID=rpi-pad

# ── Base de données ─────────────────────────────────────────────────────
POSTGRES_DB=postgres
# À remplacer : au moins 24 caractères, généré aléatoirement.
#   openssl rand -base64 32
POSTGRES_PASSWORD=a_remplacer_mot_de_passe_postgres

# ── Signature des jetons ────────────────────────────────────────────────
# À remplacer : au moins 32 caractères.
#   openssl rand -base64 48
JWT_SECRET=a_remplacer_secret_de_signature_des_jetons_min_32_caracteres

# Clés API dérivées de JWT_SECRET. Celles fournies ici sont les clés de
# démonstration publiques de Supabase : elles NE DOIVENT PAS être conservées
# en production. Régénérez-les après avoir changé JWT_SECRET (procédure dans
# DEPLOIEMENT.md).
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# ── Temps réel ──────────────────────────────────────────────────────────
# Exactement 16 caractères.
REALTIME_ENC_KEY=a_remplacer_16ca
# Au moins 64 caractères : openssl rand -base64 64
REALTIME_SECRET_KEY_BASE=a_remplacer_cle_de_base_du_service_temps_reel_minimum_64_caracteres_aleatoires

# ── Notifications par courriel (facultatif) ─────────────────────────────
# Laisser vide désactive l'envoi : les notifications restent visibles dans
# l'application, seul le courriel d'accompagnement n'est pas expédié.
RESEND_API_KEY=
